# One image and one tag. Driver versions are intentionally not configured.
RETROPIE_IMAGE=manzolo/retropie:latest
CONTAINER_NAME=retropie-container
CONTAINER_USERNAME=manzolo
# Relative paths are resolved from the repository root by make/scripts.
RETROPIE_DATA_DIR=./data
# Optional existing ROM collection (mounted read-only, never copied/chowned).
# RETROPIE_ROMS_DIR=~/RetroPie/roms
# UID/GID default to the invoking user; set these when moving between machines.
# PUID=1000
# PGID=1000
TZ=Europe/Rome
# GPU: auto (NVIDIA when the driver and the NVIDIA Container Toolkit work, otherwise Mesa:
# Intel, AMD or software rendering), nvidia or mesa.
# RETROPIE_GPU=auto
# Desktop session: auto (Wayland when its socket exists, otherwise X11), wayland or x11.
# RETROPIE_SESSION=auto
# Display and Xauthority are detected from the current desktop session.
# XAUTHORITY=/run/user/1000/xauth_example
# Force Xwayland if native EGL-Wayland is unavailable:
# SDL_VIDEODRIVER=x11
# GDK_BACKEND=x11
